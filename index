<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cloud Backup &amp; Disaster Recovery UK | [Brand Name]</title>
<meta name="description" content="Cloud backup and disaster recovery services for UK businesses. Explore Microsoft 365 backup, cloud replication and tailored data protection solutions.">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>/* ==========================================================================
   [Brand Name] design system. Shared by every page.
   1 Tokens  2 Base  3 Buttons  4 Header + mega menu  5 3D cloud  6 Cards
   7 Page sections  8 Footer  9 Reveal  10 Responsive  11 Reduced motion
   ========================================================================== */
/* 1 Tokens */
:root{--white:#fff;--sky:#EEF5FC;--lav:#EFEEFB;--aqua:#E6F4F3;--blue:#2F6BE8;--blue-d:#2457C9;--navy:#14284B;--ink:#22344D;--grey:#586882;--teal:#58AFA8;--tx:#17706B;--line:#D9E4F0;--yellow:#FFC83D;--r:28px;--sh:0 30px 50px -28px rgba(20,40,75,.38);--font:Manrope,system-ui,-apple-system,"Segoe UI",sans-serif}
/* 2 Base */
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:96px}
body{margin:0;font-family:var(--font);color:var(--ink);background:var(--white);line-height:1.6;overflow-x:hidden}
a{color:inherit;text-decoration:none}h1,h2,h3{margin:0;line-height:1.1;letter-spacing:-.03em;color:var(--navy)}
img,svg{max-width:100%}:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:8px}
.wrap{max-width:1200px;margin:0 auto;padding:0 24px}section{padding:110px 0;position:relative}
.eyebrow{display:inline-block;font-weight:800;font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--tx);margin-bottom:14px}
h2{font-size:clamp(30px,4vw,48px);font-weight:800}.lead{color:var(--grey);font-size:18px;max-width:560px;margin:0}
.sec-head{max-width:760px;margin-bottom:56px}.sec-head .lead{margin-top:18px}.center{text-align:center}.center.sec-head{margin-inline:auto}
.skip{position:absolute;left:-999px}.skip:focus{left:16px;top:16px;z-index:99;background:#fff;padding:10px 16px;border-radius:10px}
/* 3 Buttons */
.btn{display:inline-flex;align-items:center;gap:10px;padding:16px 28px;border-radius:999px;font:700 15px var(--font);border:2px solid transparent;cursor:pointer;transition:transform .3s,box-shadow .3s,border-color .3s,background .3s}
.btn-p{background:var(--blue);color:#fff;box-shadow:0 10px 24px -10px var(--blue)}.btn-p:hover{transform:translateY(-3px);box-shadow:0 16px 28px -10px var(--blue)}
.btn-s{background:#fff;border-color:var(--line);color:var(--navy)}.btn-s:hover{border-color:var(--blue);transform:translateY(-3px)}
.btn-y{background:var(--yellow);color:var(--navy);box-shadow:0 14px 28px -12px rgba(255,200,61,.7)}.btn-y:hover{transform:translateY(-3px)}
.btn-o{border-color:rgba(255,255,255,.5);color:#fff}.btn-o:hover{background:rgba(255,255,255,.1);transform:translateY(-3px)}
.ctas{display:flex;flex-wrap:wrap;gap:14px}
/* 4 Header + mega menu */
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.88);backdrop-filter:blur(14px);border-bottom:1px solid transparent;transition:border-color .3s}.site-header.sc{border-color:var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:18px;height:80px}
.logo{display:flex;align-items:center;gap:10px;font-weight:800;font-size:21px;color:var(--navy);white-space:nowrap}
.logo i{width:34px;height:34px;border-radius:12px 12px 12px 4px;background:linear-gradient(135deg,var(--blue),var(--teal))}
.menu{display:flex;align-items:center;gap:24px;list-style:none;margin:0;padding:0;font-weight:600;font-size:15px}
.menu>li>a,.dd-btn{position:relative;padding:6px 0;background:none;border:0;font:inherit;color:inherit;cursor:pointer}
.menu>li>a:after,.dd-btn:after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--tx);transition:width .3s}
.menu>li>a:hover:after,.dd-btn:hover:after,.dd.open .dd-btn:after,.menu a[aria-current]:after{width:100%}
.dd-btn{display:inline-flex;align-items:center;gap:6px}.dd-btn svg{transition:transform .3s}.dd.open .dd-btn svg{transform:rotate(180deg)}
.nav-cta{padding:13px 22px;font-size:14px;white-space:nowrap}.menu .m-cta{display:none}
.burger{display:none;background:none;border:0;width:44px;height:44px;cursor:pointer;color:var(--navy)}.burger span{display:block;width:24px;height:2px;background:currentColor;margin:6px auto;transition:.3s}
.nav{position:relative}.dd{position:static}
.mega{position:absolute;left:24px;right:24px;top:100%;padding-top:10px;opacity:0;visibility:hidden;transform:translateY(10px);transition:opacity .3s,transform .3s,visibility .3s;z-index:60}
.mega-in{display:grid;grid-template-columns:1.2fr 1fr .9fr;gap:8px;background:#fff;border:1px solid var(--line);border-radius:28px;padding:18px;box-shadow:0 40px 70px -30px rgba(20,40,75,.45)}
.dd.open .mega{opacity:1;visibility:visible;transform:none}
.mega-col{padding:18px;border-radius:20px}.mega-col:nth-child(1){background:linear-gradient(160deg,var(--sky),#fff)}.mega-col:nth-child(2){background:linear-gradient(160deg,var(--lav),#fff)}.mega-col:nth-child(3){background:linear-gradient(160deg,var(--aqua),#fff)}
.mega h3{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--tx);font-weight:800;margin:0 0 12px;padding-bottom:10px;border-bottom:2px solid var(--line)}
.mega ul{list-style:none;margin:0;padding:0;display:grid;gap:2px}.mega a{display:block;padding:9px 12px;border-radius:12px;font-weight:600;font-size:15px;transition:background .2s,color .2s,padding .2s}
.mega a:hover,.mega a:focus-visible{background:rgba(47,107,232,.1);color:var(--blue-d);padding-left:16px}
/* 5 3D cloud (HTML: .stage > .blob + .scene > .tilt > .cloud; JS adds depth layers) */
.stage{position:relative;font-size:clamp(10px,1.5vw,17px);width:30em;height:28em;max-width:100%;margin-left:auto}
.blob{position:absolute;inset:0;background:linear-gradient(160deg,var(--sky),var(--lav) 55%,var(--aqua));border-radius:58% 42% 52% 48%/48% 56% 44% 52%;animation:morph 14s ease-in-out infinite}
@keyframes morph{50%{border-radius:42% 58% 46% 54%/56% 44% 56% 44%}}
.scene{position:absolute;inset:0;perspective:70em}.tilt{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .5s ease-out}
.cloud{position:absolute;left:3em;top:5em;width:24em;height:15em;transform-style:preserve-3d;animation:cfloat 8s ease-in-out infinite}
@keyframes cfloat{0%,100%{transform:rotateX(14deg) rotateY(-20deg) translateY(0)}50%{transform:rotateX(9deg) rotateY(-9deg) translateY(-1.4em)}}
.layer{position:absolute;inset:0;transform:translateZ(var(--z,0));filter:brightness(var(--b,1)) saturate(1.25)}
.puff{position:absolute;border-radius:50%;background:radial-gradient(circle at 34% 26%,#fff 0,#eaf2ff 40%,#b7cffa 100%)}
.puff.base{left:0;top:6em;width:24em;height:9em;border-radius:4.5em}.p1{left:2.5em;top:3.5em;width:9em;height:9em}.p2{left:7em;top:0;width:11em;height:11em}.p3{left:14em;top:3em;width:8em;height:8em}
.layer.front .puff{box-shadow:inset -.9em -1.2em 2em rgba(47,107,232,.28),inset .8em .9em 1.4em rgba(255,255,255,.95)}
.badge{position:absolute;left:8.5em;top:3.6em;width:7em;transform:translateZ(5em);filter:drop-shadow(0 1.2em 1em rgba(20,40,75,.35))}
.badge.back{transform:translateZ(4.3em);filter:brightness(.62) saturate(1.2)}
.ring{position:absolute;left:0;top:3em;width:30em;height:30em;border:2px dashed rgba(47,107,232,.4);border-radius:50%;transform:rotateX(74deg);animation:ringspin 30s linear infinite}
.ring:after{content:"";position:absolute;left:50%;top:-.6em;width:1.2em;height:1.2em;margin-left:-.6em;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff,var(--blue))}
@keyframes ringspin{from{transform:rotateX(74deg) rotateZ(0)}to{transform:rotateX(74deg) rotateZ(360deg)}}
.shadow{position:absolute;left:5em;bottom:2.4em;width:20em;height:2.6em;border-radius:50%;background:radial-gradient(rgba(20,40,75,.3),transparent 70%);animation:sh 8s ease-in-out infinite}
@keyframes sh{50%{transform:scale(.82);opacity:.7}}
.chip{position:absolute;background:#fff;border-radius:18px;padding:12px 16px;display:flex;align-items:center;gap:10px;font-weight:700;font-size:13px;box-shadow:0 20px 40px -18px rgba(20,40,75,.4);animation:float 6s ease-in-out infinite;white-space:nowrap}
.chip b{width:30px;height:30px;border-radius:10px;background:var(--aqua);display:grid;place-items:center;color:var(--tx)}
.c1{top:6%;left:-4%}.c2{bottom:24%;right:-3%;animation-delay:-2s}.c3{bottom:4%;left:6%;animation-delay:-4s}
@keyframes float{50%{transform:translateY(-12px)}}
/* 6 Cards (single-select group: [data-select]) */
.card{background:linear-gradient(160deg,#fff 40%,var(--lav));border:2px solid transparent;border-radius:var(--r);padding:36px;position:relative;overflow:hidden;transition:transform .4s,box-shadow .4s,background .4s,color .4s,border-color .4s}
.card:hover{transform:translateY(-6px);box-shadow:var(--sh);border-color:#c9d6f7}
.card h3{font-size:28px;margin-bottom:12px}.card p{color:var(--grey);margin:0 0 16px;max-width:430px;position:relative}.card .num{display:block;font-weight:800;font-size:13px;letter-spacing:.12em;color:var(--tx);margin-bottom:12px}
.pick{all:unset;cursor:pointer}.pick:focus-visible{outline:3px solid var(--blue);outline-offset:6px;border-radius:6px}.pick:after{content:"";position:absolute;inset:0}
.more{position:relative;z-index:2;display:inline-block;font-weight:800;color:var(--blue-d);transition:transform .3s}.more:hover{transform:translateX(4px)}
.state{position:absolute;top:26px;right:26px;font-size:12px;font-weight:800;padding:6px 12px;border-radius:999px;background:#fff;color:var(--blue);opacity:0;transform:scale(.9);transition:.3s}
.art{position:absolute;right:-16px;bottom:-16px;width:200px;opacity:.9;transition:transform .6s;pointer-events:none}.card:hover .art{transform:scale(1.08) rotate(-4deg)}
.card.sel{background:linear-gradient(160deg,#4a7cf0,var(--blue-d));color:#fff;border-color:var(--blue-d);box-shadow:0 34px 56px -26px rgba(36,87,201,.7);transform:translateY(-4px)}
.card.sel h3,.card.sel .more{color:#fff}.card.sel p{color:#e4edff}.card.sel .num{color:#cfe0ff}.card.sel .art{opacity:.4}.card.sel .state{opacity:1;transform:none}
/* 7 Page sections */
.pale{background:var(--sky);border-radius:60px;margin:0 20px}.pale-aqua{background:var(--aqua);border-radius:60px;margin:20px 20px 0}
.hero{overflow-x:clip;padding:60px 0 120px;background:radial-gradient(900px 500px at 85% 20%,var(--aqua),transparent 70%),radial-gradient(500px 400px at 0 0,var(--lav),transparent 70%)}
.hgrid{display:grid;grid-template-columns:1.12fr 1fr;gap:40px;align-items:center}
.hero h1{font-size:clamp(36px,4.5vw,58px);font-weight:800;max-width:640px}
.hero h1 em{font-style:normal;color:#2252c8;background:linear-gradient(transparent 64%,rgba(47,107,232,.2) 64%) no-repeat 0 0/0 100%;transition:background-size 1.3s .6s;padding:0 .08em;box-decoration-break:clone;-webkit-box-decoration-break:clone}.in h1 em{background-size:100% 100%}
.hero .lead{margin-top:20px}.hero .ctas{margin-top:30px}
.sup{display:flex;align-items:center;gap:12px;margin-top:30px;padding-top:22px;border-top:1px solid var(--line);color:var(--grey);font-weight:600;font-size:14px;max-width:520px}
.sgrid{display:grid;grid-template-columns:1.3fr 1fr;gap:24px}.sc1{grid-row:span 2;min-height:460px}
.card:not(.sc1) .art{top:68px;bottom:auto;right:22px;width:84px}.card:not(.sc1) p{max-width:calc(100% - 100px)}
.ag{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}.ag h3{font-size:20px;margin:28px 0 14px}
.chk{list-style:none;margin:0 0 20px;padding:0;display:grid;gap:12px;font-weight:600}.chk li{display:flex;gap:12px}.chk li:before{content:"✓";flex:none;width:24px;height:24px;border-radius:50%;background:var(--blue);color:#fff;font-size:13px;display:grid;place-items:center;margin-top:1px}
.supl{margin:18px 0 0;font-weight:700;color:var(--tx)}
.rep{background:#fff;border-radius:34px;padding:30px;box-shadow:0 40px 70px -30px rgba(20,40,75,.4);transform:rotate(2.5deg);transition:transform .5s;max-width:460px;margin:auto;width:100%}.rep:hover{transform:none}
.rh{display:flex;justify-content:space-between;font-weight:700;font-size:13px;color:var(--grey);margin-bottom:18px}.score{display:flex;align-items:center;gap:22px;margin-bottom:22px}.score svg{width:110px;height:110px;flex:none}
.rows{display:grid;gap:14px}.row{display:grid;gap:6px;font-size:13px;font-weight:700}.bar{height:8px;border-radius:9px;background:var(--sky);overflow:hidden}.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--teal));transition:width 1.4s .3s}.in .bar i{width:var(--w)}
.rec{margin-top:18px;background:var(--sky);border-radius:16px;padding:14px;font-size:13px;font-weight:600}.note{font-size:12px;color:var(--grey);margin-top:16px}
.dg{display:grid;grid-template-columns:1fr 1.1fr;gap:70px;align-items:center}
.orbit{position:relative;aspect-ratio:1;max-width:520px;margin:auto;width:100%}.orbit .rg{position:absolute;border:2px dashed var(--line);border-radius:50%;animation:spin 60s linear infinite}.rg.r1{inset:0}.rg.r2{inset:16%;animation-direction:reverse}@keyframes spin{to{transform:rotate(360deg)}}
.core{position:absolute;inset:34%;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--teal));display:grid;place-items:center;color:#fff;font-weight:800;text-align:center;padding:10px;box-shadow:0 30px 60px -20px var(--blue)}
.pt{position:absolute;background:#fff;border-radius:18px;padding:10px 16px;font-weight:700;font-size:12.5px;line-height:1.3;text-align:center;max-width:170px;box-shadow:0 12px 30px -14px rgba(20,40,75,.4);animation:float 7s ease-in-out infinite}
.dl{list-style:none;padding:0;margin:34px 0 0;display:grid;gap:22px}.dl li{display:grid;grid-template-columns:54px 1fr;gap:18px}.dl b{font-size:20px;color:var(--tx);font-weight:800}.dl h3{font-size:19px;margin-bottom:4px}.dl p{margin:0;color:var(--grey);font-size:15px}
/* How It Works: the earlier design (numbered circles on a dashed line, staggered middle step) */
.pg{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin:70px 0 56px;position:relative}
.pg:before{content:"";position:absolute;top:44px;left:17%;right:17%;border-top:2px dashed var(--teal);opacity:.5}
.st{text-align:center;position:relative}.st:nth-child(even){margin-top:46px}
.dot{width:88px;height:88px;border-radius:50%;background:#fff;border:2px solid var(--line);display:grid;place-items:center;margin:0 auto 20px;font-weight:800;font-size:22px;color:var(--blue);transition:.4s}
.st:hover .dot{background:var(--blue);color:#fff;transform:scale(1.08)}.st h3{font-size:19px;margin-bottom:8px}.st p{color:var(--grey);margin:0 auto;font-size:15px;max-width:290px}
.par{background:var(--sky);padding:80px 0}.pl{display:grid;grid-template-columns:repeat(6,1fr);gap:18px;margin-top:40px}
.pl div{background:#fff;border:1px solid var(--line);border-radius:22px;height:96px;display:grid;place-items:center;padding:12px;font-weight:800;font-size:19px;color:#44546a;transition:transform .3s,box-shadow .3s;text-align:center;line-height:1.1}.pl div:hover{transform:translateY(-5px);box-shadow:var(--sh)}
.pl small{display:block;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--grey)}
.cta-band{margin:0 20px;border-radius:60px;background:linear-gradient(135deg,var(--navy),#1f4290 60%,var(--blue));color:#fff;text-align:center;overflow:hidden;padding:100px 24px;position:relative}
.cta-band h2{color:#fff;max-width:800px;margin:0 auto 20px}.cta-band p{max-width:560px;margin:0 auto 34px;color:#dbe7ff;font-size:18px}.cta-band .ctas{justify-content:center}.cta-band>*{position:relative}
.cta-band .o{position:absolute;border-radius:50%;background:rgba(255,255,255,.07);animation:float 9s ease-in-out infinite}.shield{display:block;margin:0 auto 24px;animation:float 6s ease-in-out infinite}
/* 8 Footer */
.site-footer{padding:90px 0 40px}.fgrid{display:grid;grid-template-columns:1.5fr 1fr 1fr 1.2fr;gap:40px}.site-footer h4{margin:0 0 16px;font-size:15px;color:var(--navy)}
.site-footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;color:var(--grey);font-size:15px}.site-footer li a:hover{color:var(--blue)}
.fb{margin-top:60px;padding-top:24px;border-top:1px solid var(--line);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;color:var(--grey);font-size:14px}
/* 9 Reveal */
.rv{opacity:0;transform:translateY(30px);transition:opacity .9s,transform .9s}.rv.in{opacity:1;transform:none}
/* 10 Responsive */
@media(max-width:1140px){
 .nav-cta{display:none}.burger{display:block}.menu .m-cta{display:block}
 .menu{position:fixed;inset:80px 0 auto 0;flex-direction:column;align-items:stretch;gap:14px;background:#fff;padding:20px 24px 30px;border-bottom:1px solid var(--line);font-size:18px;max-height:calc(100vh - 80px);overflow:auto;transform:translateY(-130%);transition:transform .4s;z-index:-1}
 .menu.open{transform:none}.mega{position:static;padding:0;opacity:1;visibility:visible;transform:none;display:none}.dd.open .mega{display:block}
 .mega-in{grid-template-columns:1fr;border:0;box-shadow:none;padding:8px 0 0}.mega-col{padding:12px}
}
@media(max-width:980px){
 section{padding:80px 0}.hgrid,.sgrid,.ag,.dg{grid-template-columns:1fr}.sc1{grid-row:auto;min-height:0}.stage{margin:10px auto 0;font-size:min(17px,calc((100vw - 48px)/30))}
 .pg{grid-template-columns:1fr;gap:34px;margin:50px 0 40px}.pg:before{display:none}.st:nth-child(even){margin-top:0}.pale,.pale-aqua,.cta-band{border-radius:36px}
 .pl{grid-template-columns:repeat(3,1fr)}.rep{transform:none}.fgrid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.fgrid{grid-template-columns:1fr}.btn{width:100%;justify-content:center}.pl{grid-template-columns:repeat(2,1fr)}.card{padding:28px}.pale,.pale-aqua,.cta-band{margin-inline:10px}
 .c1{left:0}.c2{right:0}.pt{font-size:11px;padding:8px 12px;max-width:128px}.stage{font-size:clamp(9.5px,3.1vw,13px)}}
/* 11 Reduced motion */
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}.rv{opacity:1;transform:none}.bar i{width:var(--w)}.hero h1 em{background-size:100% 100%}.cloud{transform:rotateX(12deg) rotateY(-16deg)}.ring{transform:rotateX(74deg)}}
</style>
</head>
