document.getElementById('site-header').outerHTML=header;document.getElementById('site-footer').outerHTML=footer;

const $=s=>document.querySelector(s),hd=$('#hd'),menu=$('#menu'),bg=$('#bg'),dd=$('#dd'),btn=dd.querySelector('.dd-btn');
const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches,hover=matchMedia('(hover:hover) and (min-width:1141px)');
addEventListener('scroll',()=>hd.classList.toggle('sc',scrollY>10),{passive:true});
bg.onclick=()=>{const o=menu.classList.toggle('open');bg.setAttribute('aria-expanded',o)};
menu.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.classList.remove('open');bg.setAttribute('aria-expanded',false)}));
/* Mega menu: hover (with short close delay), click/tap, keyboard (Enter/Space, Esc, focus leaving) */
let t;const set=o=>{dd.classList.toggle('open',o);btn.setAttribute('aria-expanded',o)};
btn.onclick=()=>set(!dd.classList.contains('open'));
dd.addEventListener('mouseenter',()=>{if(hover.matches){clearTimeout(t);set(true)}});
dd.addEventListener('mouseleave',()=>{if(hover.matches)t=setTimeout(()=>set(false),180)});
dd.addEventListener('focusout',e=>{if(!dd.contains(e.relatedTarget))set(false)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&dd.classList.contains('open')){set(false);btn.focus()}});
document.addEventListener('click',e=>{if(!dd.contains(e.target))set(false)});
/* Current page marker */
const here=location.pathname.split('/').pop()||'#top';menu.querySelectorAll('a').forEach(a=>{if(a.getAttribute('href')===here)a.setAttribute('aria-current','page')});
/* Scroll reveal */
const io=new IntersectionObserver(es=>es.forEach(x=>{if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}}),{threshold:.15});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
/* Single-select cards */
document.querySelectorAll('[data-select]').forEach(g=>{const cs=[...g.querySelectorAll('.card')];
cs.forEach(c=>c.querySelector('.pick').addEventListener('click',()=>{const on=!c.classList.contains('sel');
cs.forEach(k=>{k.classList.remove('sel');k.querySelector('.pick').setAttribute('aria-pressed','false')});
if(on){c.classList.add('sel');c.querySelector('.pick').setAttribute('aria-pressed','true')}}))});
/* 3D cloud: clone the front layer into stacked depth layers, add pointer tilt */
document.querySelectorAll('.stage').forEach(st=>{const cloud=st.querySelector('.cloud'),front=cloud&&cloud.querySelector('.layer.front');if(!front)return;
for(let i=0;i<7;i++){const l=front.cloneNode(true);l.classList.remove('front');l.setAttribute('aria-hidden','true');l.style.setProperty('--z',(-3+i*.85).toFixed(2)+'em');l.style.setProperty('--b',(.78+i*.03).toFixed(2));cloud.insertBefore(l,front)}
front.style.setProperty('--z','3em');
const tilt=st.querySelector('.tilt');if(!reduce&&tilt&&matchMedia('(hover:hover)').matches){
st.addEventListener('pointermove',e=>{const r=st.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;tilt.style.transform=`rotateY(${x*14}deg) rotateX(${-y*10}deg)`});
st.addEventListener('pointerleave',()=>tilt.style.transform='')}});
})();
