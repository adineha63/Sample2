const caret='<svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>';
const header=`<header class="site-header" id="hd"><div class="wrap nav"><a class="logo" href="index.html"><i></i>[Brand Name]</a>
<nav aria-label="Main"><ul class="menu" id="menu">${li(NAV[0])}
<li class="dd" id="dd"><button class="dd-btn" type="button" aria-expanded="false" aria-controls="mega">Services ${caret}</button>
<div class="mega" id="mega"><div class="mega-in">${MEGA.map(([h,l])=>`<div class="mega-col"><h3>${h}</h3><ul>${l.map(li).join('')}</ul></div>`).join('')}</div></div></li>
${NAV.slice(1).map(li).join('')}<li class="m-cta"><a class="btn btn-p" href="#assessment">Get Your Free Backup Assessment</a></li></ul></nav>
<a class="btn btn-p nav-cta" href="#assessment">Get Your Free Backup Assessment</a>
<button class="burger" id="bg" type="button" aria-label="Open menu" aria-expanded="false"><span></span><span></span></button></div></header>`;
const footer=`<footer class="site-footer"><div class="wrap"><div class="fgrid"><div><a class="logo" href="index.html"><i></i>[Brand Name]</a><p style="color:var(--grey);max-width:300px">Cloud backup and disaster recovery solutions for UK businesses.</p></div>
<div><h4>Explore</h4><ul><li><a href="services/cloud-backup.html">Cloud Backup</a></li><li><a href="services/draas.html">Disaster Recovery</a></li><li><a href="services/backup-as-a-service.html">Backup as a Service</a></li><li><a href="backup-strategy.html">Backup Strategy</a></li></ul></div>
<div><h4>Company</h4><ul><li><a href="about-us.html">About Us</a></li><li><a href="resources.html">Resources</a></li><li><a href="#contact">Contact Us</a></li></ul></div>
